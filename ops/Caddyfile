{
	email {$ACME_EMAIL}
	admin localhost:2019
}
{$APP_DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	header -Server
	request_body {
		max_size 256KB
	}
	reverse_proxy app:3000 {
		# Overwrite, never trust a client-supplied address for login throttling.
		header_up X-Client-IP {remote_host}
		transport http {
			dial_timeout 5s
			response_header_timeout 60s
		}
	}
	# No access log: URLs, session cookies and request bodies stay out of logs.
}
