# Execute npm run setup:env para gerar senhas locais aleatórias.
POSTGRES_USER=central
POSTGRES_PASSWORD=SUBSTITUA_POR_UMA_SENHA_ALEATORIA
POSTGRES_DB=central_suporte
POSTGRES_PORT=54329
DATABASE_URL=postgresql://central:SUBSTITUA_POR_UMA_SENHA_ALEATORIA@localhost:54329/central_suporte
APP_URL=http://localhost:3000
# false SOMENTE para HTTP local. Em HTTPS, obrigatoriamente true.
COOKIE_SECURE=false
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE
