# Copy to .env.production (chmod 600). Never use .env or .env.demo for this stack.
COMPOSE_PROJECT_NAME=central-suporte-prod
RELEASE=local
APP_DOMAIN=
ACME_EMAIL=
APP_URL=
APP_ORGANIZATION_ID=initial-organization
APP_TIMEZONE=America/Belem
POSTGRES_DB=central_suporte_production
POSTGRES_USER=central_owner
POSTGRES_PASSWORD=
APP_DB_USER=central_app
APP_DB_PASSWORD=
INITIAL_ORGANIZATION_NAME=
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
BACKUP_RETENTION_DAYS=14
# Optional executable hook; receives the completed archive path as its only argument.
BACKUP_COPY_HOOK=
# Pin tested image digests before deployment; update them deliberately with security updates.
NODE_IMAGE=node:24-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6
POSTGRES_IMAGE=postgres:17-alpine@sha256:f02121de6f74d30d8a94cd1d9584125e2178d7e6c377d8130112d4e52d867995
CADDY_IMAGE=caddy:2-alpine@sha256:de23def33b17fb5d1290b0f6c2add1d70780e52341896c00a4c8a2a2fe9d355e
