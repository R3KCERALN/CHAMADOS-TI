# Execute npm run setup:env para gerar senhas locais aleatórias.
POSTGRES_USER=central
POSTGRES_PASSWORD=SUBSTITUA_POR_UMA_SENHA_ALEATORIA
POSTGRES_DB=central_suporte
POSTGRES_PORT=54329
DATABASE_URL=postgresql://central:SUBSTITUA_POR_UMA_SENHA_ALEATORIA@localhost:54329/central_suporte
APP_URL=http://localhost:3000
# false SOMENTE para HTTP local. Em HTTPS, obrigatoriamente true.
COOKIE_SECURE=false
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE

# Fuso das telas e filtros gerenciais; timestamps do banco permanecem UTC.
APP_TIMEZONE=America/Belem

# Escopo fixo desta instalação; não é um campo do login.
APP_ORGANIZATION_ID=initial-organization
INITIAL_ORGANIZATION_NAME=Organização inicial

# Web Push opcional. Gere o par uma vez com npm run push:keys; nunca versione chaves reais.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato público real do operador: mailto:ti@empresa.com ou URL HTTPS.
VAPID_SUBJECT=
# false suspende somente o despacho; usado nos testes sem tráfego externo.
PUSH_WORKER_ENABLED=true
