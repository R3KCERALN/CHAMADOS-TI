generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
enum Role {
  ADMIN
  FUNCIONARIO
  TI
  GESTOR
}
enum Impact {
  BLOQUEADO
  PARCIAL
  BAIXO
}
enum TicketStatus {
  NOVO
  EM_ATENDIMENTO
  AGUARDANDO
  RESOLVIDO
}
enum TicketOrigin {
  PORTAL
  ATENDIMENTO_RAPIDO
}
enum WaitingReason {
  USUARIO
  FORNECEDOR
  PECA
  APROVACAO
  OUTRO
}
enum EventType {
  CRIADO
  ASSUMIDO
  APOIO_ADICIONADO
  APOIO_REMOVIDO
  STATUS_ALTERADO
  AGUARDANDO
  RETOMADO
  RESPONSAVEL_ALTERADO
  COMENTARIO
  RESOLVIDO
  REABERTO
  CATEGORIA_ALTERADA
  COMPLEXIDADE_ALTERADA
  LOCALIZACAO_ALTERADA
  EQUIPE_ALTERADA
}
enum Complexity {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}
model Category {
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id        String @id @default(cuid())
  teamId    String
  team      Team @relation(fields: [teamId], references: [id], onDelete: Restrict)
  name      String
  active    Boolean @default(true)
  createdAt DateTime @default(now())
  tickets   Ticket[]
  previousEvents TicketEvent[] @relation("PreviousCategory")
  nextEvents TicketEvent[] @relation("NextCategory")
  @@unique([teamId, name])
  @@index([teamId])
}
model Department {
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  users     User[]
  tickets   Ticket[]
  @@unique([organizationId, name])
}
model User {
  ticketRevision BigInt @default(0)
  pushSubscriptions PushSubscription[]
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id                 String @id @default(cuid())
  name               String
  username           String @unique
  passwordHash       String
  departmentId       String
  department         Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  role               Role @default(FUNCIONARIO)
  active             Boolean @default(true)
  mustChangePassword Boolean @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  teamId String?
  team Team? @relation(fields: [teamId], references: [id], onDelete: Restrict)
  primaryCompanyId String?
  primaryCompany Company? @relation(fields: [primaryCompanyId], references: [id], onDelete: Restrict)
  primaryUnitId String?
  primaryUnit Unit? @relation(fields: [primaryUnitId], references: [id], onDelete: Restrict)
  companyAccess UserCompanyAccess[]
  unitAccess UserUnitAccess[]
  openedTickets Ticket[] @relation("OpenedBy")
  sessions           Session[]
  requests           Ticket[] @relation("Requester")
  assignments        Ticket[] @relation("Assignee")
  participants       TicketParticipant[]
  events             TicketEvent[] @relation("EventActor")
  targetedEvents     TicketEvent[] @relation("EventTarget")
  comments           TicketComment[]
  auditActions       UserAudit[] @relation("AuditActor")
  auditSubjects      UserAudit[] @relation("AuditSubject")
  @@index([departmentId])
  @@index([role, active])
  @@index([organizationId, role, active])
  @@index([primaryCompanyId])
  @@index([primaryUnitId])
  @@index([teamId])
}
model Session {
  id        String @id @default(cuid())
  tokenHash String @unique
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
  @@index([userId])
  @@index([expiresAt])
}
model LoginThrottle {
  key       String @id
  attempts  Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}
model Ticket {
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id              String @id @default(cuid())
  number          Int @unique @default(autoincrement())
  description     String
  impact          Impact
  status          TicketStatus @default(NOVO)
  origin          TicketOrigin @default(PORTAL)
  companyId String?
  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  unitId String?
  unit Unit? @relation(fields: [unitId], references: [id], onDelete: Restrict)
  openedByUserId String?
  openedByUser User? @relation("OpenedBy", fields: [openedByUserId], references: [id], onDelete: Restrict)
  teamId String
  team Team @relation(fields: [teamId], references: [id], onDelete: Restrict)
  requesterName String
  requesterId     String?
  requester       User? @relation("Requester", fields: [requesterId], references: [id], onDelete: Restrict)
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  assigneeId      String?
  assignee        User? @relation("Assignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  waitingReason   WaitingReason?
  waitingNote     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  startedAt       DateTime?
  resolvedAt      DateTime?
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  complexity      Complexity?
  participants    TicketParticipant[]
  events          TicketEvent[]
  comments        TicketComment[]
  @@index([organizationId, createdAt])
  @@index([organizationId, resolvedAt])
  @@index([organizationId, status])
  @@index([teamId, status])
  @@index([teamId, createdAt])
  @@index([companyId, createdAt])
  @@index([unitId, createdAt])
  @@index([openedByUserId])
  @@index([requesterId, createdAt])
  @@index([status, createdAt])
  @@index([assigneeId, status])
  @@index([departmentId])
  @@index([createdAt])
  @@index([resolvedAt])
  @@index([categoryId, createdAt])
  @@index([complexity, createdAt])
  @@index([departmentId, createdAt])
  @@index([assigneeId, resolvedAt])
}
model TicketParticipant {
  ticketId  String
  userId    String
  joinedAt  DateTime @default(now())
  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  user      User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@id([ticketId, userId])
  @@index([userId])
}
model TicketEvent {
  pushDeliveries PushDelivery[]
  id            String @id @default(cuid())
  sequence      Int @unique @default(autoincrement())
  ticketId      String
  ticket        Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  type          EventType
  actorId       String
  actor         User @relation("EventActor", fields: [actorId], references: [id], onDelete: Restrict)
  targetUserId  String?
  targetUser    User? @relation("EventTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  fromStatus    TicketStatus?
  toStatus      TicketStatus?
  waitingReason WaitingReason?
  note          String?
  metadata      Json?
  previousCategoryId String?
  previousCategory Category? @relation("PreviousCategory", fields: [previousCategoryId], references: [id], onDelete: Restrict)
  nextCategoryId String?
  nextCategory Category? @relation("NextCategory", fields: [nextCategoryId], references: [id], onDelete: Restrict)
  previousComplexity Complexity?
  nextComplexity Complexity?
  createdAt     DateTime @default(now())
  @@index([ticketId, createdAt])
  @@index([actorId])
  @@index([targetUserId])
  @@index([type, createdAt])
  @@index([ticketId, sequence])
  @@index([targetUserId, type, createdAt])
  @@index([previousCategoryId])
  @@index([nextCategoryId])
}
model TicketComment {
  id        String @id @default(cuid())
  ticketId  String
  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  authorId  String
  author    User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  content   String
  createdAt DateTime @default(now())
  @@index([ticketId, createdAt])
  @@index([authorId])
}
model UserAudit {
  id        String @id @default(cuid())
  actorId   String
  actor     User @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  subjectId String
  subject   User @relation("AuditSubject", fields: [subjectId], references: [id], onDelete: Restrict)
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
  @@index([actorId])
  @@index([subjectId, createdAt])
}

model Organization {
  ticketRevision BigInt @default(0)
  pushSubscriptions PushSubscription[]
  id String @id @default(cuid())
  name String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users User[]
  departments Department[]
  categories Category[]
  companies Company[]
  tickets Ticket[]
  teams Team[]
}
model Team {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  key String
  name String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  users User[]
  tickets Ticket[]
  categories Category[]
  @@unique([organizationId, key])
}
model Company {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  displayName String
  legalName String?
  cnpj String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  units Unit[]
  users User[]
  access UserCompanyAccess[]
  tickets Ticket[]
  @@unique([organizationId, cnpj])
  @@index([organizationId, active])
}
model Unit {
  id String @id @default(cuid())
  companyId String
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name String
  code String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users User[]
  access UserUnitAccess[]
  tickets Ticket[]
  @@unique([companyId, name])
}
model UserCompanyAccess {
  userId String
  companyId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  @@id([userId, companyId])
  @@index([companyId])
}
model UserUnitAccess {
  userId String
  unitId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  @@id([userId, unitId])
  @@index([unitId])
}

model PushSubscription {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  endpoint String
  endpointHash String @unique
  p256dh String
  auth String
  sessionHash String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deliveries PushDelivery[]
  @@index([organizationId, userId, active])
  @@index([sessionHash])
}
model PushDelivery {
  id String @id @default(cuid())
  eventId String
  event TicketEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  subscriptionId String
  subscription PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  status String @default("PENDING")
  attempts Int @default(0)
  availableAt DateTime @default(now())
  leaseToken String?
  createdAt DateTime @default(now())
  finishedAt DateTime?
  lastStatus Int?
  @@unique([eventId, subscriptionId])
  @@index([status, availableAt])
  @@index([createdAt])
}
