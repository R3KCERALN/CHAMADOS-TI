{
	email {$ACME_EMAIL}
	admin localhost:2019
}
{$APP_DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	header -Server
	@stock_upload path /api/estoque/uso-avulso
	@other_requests not path /api/estoque/uso-avulso
	request_body @stock_upload {
		max_size 6MB
	}
	request_body @other_requests {
		max_size 256KB
	}
	# O app não usa next/image; fecha a superfície do otimizador de imagens.
	@next_image path /_next/image /_next/image/*
	respond @next_image 404
	reverse_proxy app:3000 {
		# Overwrite, never trust a client-supplied address for login throttling.
		header_up X-Client-IP {remote_host}
		transport http {
			dial_timeout 5s
			response_header_timeout 60s
		}
	}
	# No access log: URLs, session cookies and request bodies stay out of logs.
}
